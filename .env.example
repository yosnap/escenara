# Copia este fichero a `.env` (lo usan Docker Compose y la aplicación) y cambia las contraseñas.
# `.env` está en .gitignore: nunca lo subas al repositorio.

# PostgreSQL local (puerto fijo 5421)
POSTGRES_DB=escenara
POSTGRES_USER=escenara
POSTGRES_PASSWORD=cambia-esta-contrasena
DATABASE_URL=postgresql://escenara:cambia-esta-contrasena@localhost:5421/escenara

# Almacenamiento de objetos: SeaweedFS con API S3 (puerto fijo 8321)
S3_ENDPOINT=http://localhost:8321
S3_REGION=us-east-1
S3_BUCKET=escenara
S3_ACCESS_KEY_ID=escenara-local
S3_SECRET_ACCESS_KEY=cambia-este-secreto

# Endpoint PÚBLICO del mismo almacenamiento (opcional). Solo lo necesita APIMart (ADR-0044): firma una URL
# GET de 50 min para que el proveedor baje la referencia, porque APIMart no sube nada. Sin esta variable
# la instalación no puede usar APIMart (error claro al generar, sin gasto); KIE no la necesita.
# S3_ENDPOINT_PUBLIC=https://mi-almacen-publico.ejemplo.com

# Autenticación (Better Auth). Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=genera-un-secreto-de-32-bytes
BETTER_AUTH_URL=http://localhost:3021

# Bóveda de secretos (ADR-0005): cifra las claves de API de cada usuario y los secretos de la
# instalación. Genera la clave con: openssl rand -base64 32
# Vacía, la aplicación arranca con la bóveda desactivada: no se pueden guardar credenciales ni
# secretos hasta que pongas una clave y reinicies.
# Si la pierdes, habrá que volver a guardar todas las claves: inclúyela en tus copias de seguridad.
ESCENARA_CLAVE_MAESTRA=

# Solo durante una rotación de la clave maestra: pon aquí la anterior, ejecuta
# `bun run boveda:recifrar` y después borra esta línea.
# ESCENARA_CLAVE_MAESTRA_ANTERIOR=

# El resto de la configuración está en Admin › Ajustes: registro, cuota, correo (servidor y
# contraseña), cabecera de IP y las claves de acceso con Google y GitHub. Los secretos se guardan
# cifrados con la clave maestra, nunca en este archivo.
