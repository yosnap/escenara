# Copia este fichero a `.env` (lo usan Docker Compose y la aplicación) y cambia las contraseñas.
# `.env` está en .gitignore: nunca lo subas al repositorio.

# PostgreSQL local (puerto fijo 5421)
POSTGRES_DB=escenara
POSTGRES_USER=escenara
POSTGRES_PASSWORD=cambia-esta-contrasena
DATABASE_URL=postgresql://escenara:cambia-esta-contrasena@localhost:5421/escenara

# Almacenamiento de objetos: SeaweedFS con API S3 (puerto fijo 8321)
S3_ENDPOINT=http://localhost:8321
S3_REGION=us-east-1
S3_BUCKET=escenara
S3_ACCESS_KEY_ID=escenara-local
S3_SECRET_ACCESS_KEY=cambia-este-secreto

# Autenticación (Better Auth). Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=genera-un-secreto-de-32-bytes
BETTER_AUTH_URL=http://localhost:3021
# Pon 0 para cerrar el registro (instalaciones privadas). La primera cuenta siempre es administradora.
ESCENARA_REGISTRO_ABIERTO=1
# Solo en producción: cabecera con la IP real que escribe tu proxy (p. ej. x-real-ip). En local, vacía.
ESCENARA_CABECERAS_IP=

# Correo: en local, Mailpit (bandeja en http://localhost:8421)
SMTP_URL=smtp://localhost:1021
CORREO_REMITENTE="Escenara <no-responder@escenara.local>"

# Opcional: acceso con Google o GitHub. Sin estas claves, sus botones no aparecen.
# Google: https://console.cloud.google.com/apis/credentials (redirección: http://localhost:3021/api/auth/callback/google)
# GitHub: https://github.com/settings/developers (redirección: http://localhost:3021/api/auth/callback/github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
