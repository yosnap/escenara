{
  "capturas": [
    {
      "id": "lugar",
      "ruta": "/lugares",
      "ocultar": [
        "nextjs-portal"
      ],
      "tramos": [
        {
          "id": "nuevo",
          "acciones": [
            {
              "accion": "clic",
              "selector": "button:has-text('Crear el primero')"
            },
            {
              "accion": "esperar",
              "selector": "[role=dialog] input[placeholder='Bar de la esquina']"
            }
          ]
        },
        {
          "id": "datos",
          "acciones": [
            {
              "accion": "escribir",
              "selector": "[role=dialog] input[placeholder='Bar de la esquina']",
              "texto": "Terraza Mirto"
            },
            {
              "accion": "escribir",
              "selector": "[role=dialog] textarea",
              "texto": "Terraza de cafetería luminosa en una plaza peatonal empedrada: mesas de madera clara, sillas verdes, limoneros en macetas y toldo blanco, por la mañana."
            }
          ]
        },
        {
          "id": "acabado",
          "acciones": [
            {
              "accion": "elegir",
              "titulo": "Acabado",
              "abrir": "[role=dialog] [role=combobox]",
              "opciones": "[role=option]:visible",
              "selector": "[role=option]:visible:has-text('Real (fotos)')",
              "etiquetas": [
                "Real (fotos)",
                "Animado · Ilustración plana",
                "Animado · 3D estilizado",
                "Animado · Anime"
              ]
            }
          ]
        },
        {
          "id": "crear",
          "acciones": [
            {
              "accion": "clic",
              "selector": "[role=dialog] button:has-text('Crear lugar')"
            },
            {
              "accion": "esperar",
              "selector": "section:has(h2:has-text('Declaración de derechos'))",
              "espera": 60000,
              "indicador": false
            },
            {
              "accion": "desplazar",
              "selector": ":text('Para poder usarlo')"
            }
          ]
        },
        {
          "id": "generar",
          "acciones": [
