          "acciones": [
            {
              "accion": "desplazar",
              "selector": "section:has(h2:has-text('Declaración de derechos')) label:has-text('Puedo usar estas imágenes')"
            },
            {
              "accion": "clic",
              "selector": "section:has(h2:has-text('Declaración de derechos')) label:has-text('Puedo usar estas imágenes')"
            },
            {
              "accion": "clic",
              "selector": "section:has(h2:has-text('Declaración de derechos')) label:has-text('no sale ningún menor')"
            },
            {
              "accion": "desplazar",
