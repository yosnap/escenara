          "acciones": [
            {
              "accion": "esperar",
              "selector": "section:has(h2:text-is('Fotos')) li >> nth=0",
              "espera": 600000,
              "recargar": true,
              "cada": 15000
            },
            {
              "accion": "desplazar",
              "selector": "section:has(h2:text-is('Fotos')) li >> nth=0"
            }
          ]
        },
