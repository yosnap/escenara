{
  "name": "escenara-video-presentacion",
  "private": true,
  "version": "0.49.2",
  "description": "Vídeo de presentación de Escenara (Remotion). Fuera de los workspaces de bun.",
  "type": "module",
  "scripts": {
    "preparar": "node scripts/preparar.mjs",
    "modelo-whisper": "mkdir -p salida/modelos && curl -fL -o salida/modelos/ggml-large-v3-turbo-q5_0.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin",
    "locucion": "node scripts/locucion.mjs",
    "audio": "node scripts/audio.mjs",
    "render": "node scripts/render.mjs",
    "estudio": "remotion studio src/index.ts",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@remotion/cli": "4.0.531",
    "@remotion/fonts": "4.0.531",
    "@remotion/media": "4.0.531",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.531"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
