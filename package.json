{
  "name": "escenara",
  "version": "0.3.0",
  "private": true,
  "description": "Estudio abierto de personajes y vídeo",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "scripts": {
    "dev": "bun --filter @escenara/web dev",
    "build": "bun --filter '*' build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "services:up": "docker compose up -d --wait postgres seaweedfs && docker compose run --rm seaweedfs-init",
    "services:down": "docker compose down",
    "prototipo": "bun spikes/prototipo/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
